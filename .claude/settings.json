{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Read(./sources/**)",
      "Read(./downloads/**)"
    ],
    "allow": [
      "Bash(python3 scripts/check_version.py)",
      "Bash(python3 scripts/check_public.py)",
      "Bash(python3 scripts/sync_preload.py *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
